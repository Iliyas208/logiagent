# Copy to .env and fill in. Never commit .env.

# AI agent: auto = Claude if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set, else rules.
# Force one with AGENT_MODE=claude | groq | rules
AGENT_MODE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CONFIDENCE_THRESHOLD=80

# Free option: Groq (key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Stripe TEST mode only (keys start with sk_test_). Empty = built-in demo payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the app is opened in the browser (used for Stripe return links)
PUBLIC_URL=http://localhost:8000

# Default: SQLite file backend/logiagent.db. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://logiagent:logiagent@localhost:5432/logiagent
DATABASE_URL=
